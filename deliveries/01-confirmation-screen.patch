diff --git a/src/components/QuoteSummary.tsx b/src/components/QuoteSummary.tsx
new file mode 100644
index 0000000..38d790e
--- /dev/null
+++ b/src/components/QuoteSummary.tsx
@@ -0,0 +1,126 @@
+import { coverageAmount, formatCZK } from '../domain/calc';
+import { isQuoteValid, quoteDaysLeft } from '../domain/quote';
+import { daysUntil, isExpiring, QUOTE_LOCK_DAYS } from '../domain/renewal';
+import { Quote } from '../domain/types';
+import { markRenewed } from '../state/renewals';
+
+interface Props {
+  today: Date;
+  onConfirmed: () => void;
+}
+
+const COUNTRIES = {
+  CZ: 'Czech Republic',
+  SK: 'Slovakia',
+  DE: 'Germany',
+  AT: 'Austria',
+  PL: 'Poland',
+};
+
+export default function QuoteSummary({ today, onConfirmed }: Props) {
+  const raw = sessionStorage.getItem('renewalQuote');
+
+  if (!raw) {
+    return <p data-cy="no-quote">There is no quote to confirm. Go back and calculate one.</p>;
+  }
+
+  const stored = JSON.parse(raw);
+  const quote: Quote = {
+    ...stored,
+    issuedAt: new Date(stored.issuedAt),
+    policy: {
+      ...stored.policy,
+      policyStart: new Date(stored.policy.policyStart),
+      renewalDate: new Date(stored.policy.renewalDate),
+    },
+  };
+
+  const { policy } = quote;
+  const expiring = isExpiring(policy.renewalDate, today);
+  const daysLeft = daysUntil(policy.renewalDate, today);
+  const valid = isQuoteValid(quote.issuedAt, today);
+  const quoteDays = quoteDaysLeft(quote.issuedAt, today);
+
+  function confirm() {
+    markRenewed(policy.policyNo);
+    sessionStorage.removeItem('renewalQuote');
+    onConfirmed();
+  }
+
+  return (
+    <>
+      <h2 className="section-label" data-cy="section-label">Policyholder</h2>
+      <dl className="summary">
+        <div className="row" data-cy="confirm-name">
+          <dt>Policyholder name</dt>
+          <dd>{quote.policyholderName}</dd>
+        </div>
+        <div className="row" data-cy="confirm-age">
+          <dt>Age</dt>
+          <dd>{quote.age}</dd>
+        </div>
+        <div className="row" data-cy="confirm-region">
+          <dt>Region</dt>
+          <dd>
+            {COUNTRIES[quote.country] || quote.country} — {quote.region}
+          </dd>
+        </div>
+      </dl>
+
+      <h2 className="section-label" data-cy="section-label">Renewal</h2>
+      <dl className="summary">
+        <div className="row" data-cy="confirm-policy">
+          <dt>Policy</dt>
+          <dd>{policy.policyNo}</dd>
+        </div>
+        <div className="row" data-cy="confirm-coverage">
+          <dt>Coverage level</dt>
+          <dd>
+            {quote.coverage} % — {formatCZK(coverageAmount(quote.coverage))}
+          </dd>
+        </div>
+        <div className="row" data-cy="confirm-claims">
+          <dt>Previous claims</dt>
+          <dd>{quote.priorClaims}</dd>
+        </div>
+        <div className="row total">
+          <dt>Renewal premium</dt>
+          <dd>
+            <h4 data-cy="confirm-premium">{formatCZK(quote.premium)}</h4>
+          </dd>
+        </div>
+      </dl>
+
+      {expiring && (
+        <div className="notice" data-cy="confirm-notice">
+          This policy expires in {daysLeft} days. The quote is locked for{' '}
+          {QUOTE_LOCK_DAYS} days.
+        </div>
+      )}
+
+      {valid ? (
+        <p data-cy="quote-validity">
+          {quoteDays === 0
+            ? 'This quote can be confirmed until the end of today.'
+            : `This quote can be confirmed for ${quoteDays} more ${quoteDays === 1 ? 'day' : 'days'}.`}
+        </p>
+      ) : (
+        <div className="notice" data-cy="quote-expired">
+          This quote has expired. Go back and calculate it again.
+        </div>
+      )}
+
+      <div className="actions">
+        <button
+          type="button"
+          className="btn btn-primary"
+          data-cy="confirm"
+          disabled={!valid}
+          onClick={confirm}
+        >
+          Confirm renewal
+        </button>
+      </div>
+    </>
+  );
+}
diff --git a/src/domain/quote.test.ts b/src/domain/quote.test.ts
new file mode 100644
index 0000000..1472161
--- /dev/null
+++ b/src/domain/quote.test.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it } from 'vitest';
+import { isQuoteValid, quoteDaysLeft } from './quote';
+import { addDays } from './renewal';
+
+const ISSUED = new Date(2025, 4, 12);
+
+describe('quoteDaysLeft', () => {
+  it('is the whole lock on the day the quote is issued', () => {
+    expect(quoteDaysLeft(ISSUED, ISSUED)).toBe(7);
+  });
+
+  it('counts down as the days pass', () => {
+    expect(quoteDaysLeft(ISSUED, addDays(ISSUED, 3))).toBe(4);
+  });
+});
+
+describe('isQuoteValid', () => {
+  it('is valid on the day it is issued', () => {
+    expect(isQuoteValid(ISSUED, ISSUED)).toBe(true);
+  });
+
+  it('is valid a few days later', () => {
+    expect(isQuoteValid(ISSUED, addDays(ISSUED, 3))).toBe(true);
+  });
+});
diff --git a/src/domain/quote.ts b/src/domain/quote.ts
new file mode 100644
index 0000000..ace8c31
--- /dev/null
+++ b/src/domain/quote.ts
@@ -0,0 +1,18 @@
+/**
+ * quote.ts — whether a calculated quote can still be confirmed.
+ *
+ * A quote is locked for QUOTE_LOCK_DAYS from the day it was issued. The last
+ * locked day still counts: a quote issued on the 1st can be confirmed up to and
+ * including the 8th.
+ */
+import { daysUntil, quoteLockedUntil } from './renewal';
+
+/** Whole days left before the lock runs out; 0 on the last day it holds. */
+export function quoteDaysLeft(issuedAt: Date, today: Date): number {
+  return daysUntil(quoteLockedUntil(issuedAt), today);
+}
+
+/** Can a quote issued on `issuedAt` still be confirmed on `today`? */
+export function isQuoteValid(issuedAt: Date, today: Date): boolean {
+  return quoteDaysLeft(issuedAt, today) >= 0;
+}
